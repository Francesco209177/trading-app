<?xml version="1.0" encoding="utf-8"?>
<!-- App Android del Portafoglio Bot: apre il sito a schermo intero.
     Costruita da build.sh, senza Gradle né librerie esterne. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.portafogliobot.app"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Portafoglio Bot"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Tema">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
